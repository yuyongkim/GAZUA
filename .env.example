# GAZUA — copy to .env and fill (or place in ~/.gazua/shared.env globally)
# Most adapters work with FREE public APIs. Get keys here:

# FRED (US Federal Reserve) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ECOS (한국은행) — https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# KOSIS (통계청) — https://kosis.kr/openapi/
KOSIS_API_KEY=

# DART (금감원) — https://opendart.fss.or.kr/uss/umt/login/loginPage.do
DART_API_KEY=

# EIA (US Energy) — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# data.go.kr (관세청 TRASS, EXIM) — https://www.data.go.kr/
DATA_GO_KR_API_KEY=
DATA_GO_KR_API_KEY_ENCODED=

# KIS (Korea Investment) — broker, optional. Account required.
# Without these, KIS index pagination is skipped (yfinance ETF used instead).
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_MARKET_TYPE=0,10,3

# LLM keys (optional — /ask endpoint falls back to rule-based without these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server config
API_HOST=127.0.0.1
API_PORT=8300
WEB_HOST=127.0.0.1
WEB_PORT=8380

# CORS
CORS_ORIGINS=http://127.0.0.1:8380,http://localhost:8380
